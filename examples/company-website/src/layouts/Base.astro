---
import '../styles/tokens.css';
import '../styles/themes/dark.css';
import '../styles/base.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';

import nrLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import nrVi from '@fontsource-variable/newsreader/files/newsreader-vietnamese-wght-normal.woff2?url';
import nrLatinIt from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import nrViIt from '@fontsource-variable/newsreader/files/newsreader-vietnamese-wght-italic.woff2?url';
import itLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import itVi from '@fontsource-variable/inter-tight/files/inter-tight-vietnamese-wght-normal.woff2?url';

import { site } from '../data/site';
import { hosted, url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title = `${site.name} - ${site.title}`, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const preload = [nrLatin, nrVi, nrLatinIt, nrViIt, itLatin, itVi];

// Dữ liệu có cấu trúc chỉ chứa thông tin đã khai báo trong site.ts, không thêm gì khác.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  description: site.description,
  ...(site.contact.email ? { email: site.contact.email } : {}),
  ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f4f1" />
    <!-- Khởi tạo theme trước lần vẽ đầu tiên để không bị nháy (file riêng, không inline, để CSP chặt không cần hash) -->
    <script is:inline src={url('theme-init.js')}></script>
    {preload.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    {(noindex || hosted) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
  </head>
  <body id="top">
    <a class="skip" href="#main">Bỏ qua đến nội dung chính</a>
    <slot />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>
