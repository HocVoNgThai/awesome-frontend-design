---
import Icon from './Icon.astro';
import { services } from '../data/site';
---

<section class="section" id="dich-vu">
  <div class="container">
    <header class="sec-head">
      <h2>Dịch vụ</h2>
      <p class="lead">
        Từ một trang giới thiệu đến hệ thống nội bộ nhiều vai trò. Chọn một hạng mục để mô tả nhu cầu của bạn.
      </p>
    </header>

    <ul class="rows">
      {
        services.map((s) => (
          <li>
            <a class="row" href="#lien-he" data-type={s.title}>
              <h3 class="title">{s.title}</h3>
              <div class="body">
                <p>{s.text}</p>
                <p class="tags mono">{s.tags}</p>
              </div>
              <span class="go" aria-hidden="true"><Icon name="arrow" /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rows {
    border-top: 1px solid var(--border-strong);
  }
  .row {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  /* Đường kẻ dưới mỗi dòng; hiện dần khi cuộn tới (nếu trình duyệt hỗ trợ) */
  .row::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--border-strong);
    transform-origin: left;
  }
  .row::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--accent);
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--dur-base) var(--ease-out);
  }
  .row:hover::before,
  .row:focus-visible::before {
    scale: 1 1;
  }
  .title {
    transition: translate var(--dur-base) var(--ease-out);
  }
  .row:hover .title,
  .row:focus-visible .title {
    translate: 0.5rem 0;
  }
  .body {
    display: grid;
    gap: var(--space-3);
    color: var(--fg-muted);
    max-width: 36rem;
  }
  .tags {
    color: var(--accent-text);
  }
  .go {
    display: none;
  }
  .go :global(svg) {
    transition: translate var(--dur-base) var(--ease-out);
  }
  .row:hover .go :global(svg) {
    translate: 4px 0;
  }

  @media (min-width: 60rem) {
    .row {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-6);
      align-items: baseline;
      padding-block: var(--space-8);
    }
    .title {
      grid-column: 1 / span 5;
    }
    .body {
      grid-column: 6 / span 6;
    }
    .go {
      display: block;
      grid-column: 12;
      justify-self: end;
      color: var(--accent-text);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .row::after {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 90%;
      }
    }
  }
  @keyframes draw {
    from {
      scale: 0 1;
    }
  }
</style>
