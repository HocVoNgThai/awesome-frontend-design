---
// Ký hiệu lấy từ chữ cái đầu của tên công ty trong site.ts, nên đổi tên là logo tự đổi theo.
import { site } from '../data/site';
const initial = site.name.trim().charAt(0).toUpperCase();
---

<span class="logo" aria-hidden="true">
  <span class="mark">{initial}</span>
</span>

<style>
  .logo {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--fg);
    color: var(--bg);
    border-radius: var(--radius);
    position: relative;
    flex: none;
  }
  .mark {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1;
    translate: 0 -0.04em;
  }
  .logo::after {
    content: '';
    position: absolute;
    right: 0.3rem;
    bottom: 0.3rem;
    width: 0.3rem;
    height: 0.3rem;
    background: var(--accent);
    border-radius: 50%;
  }
</style>
