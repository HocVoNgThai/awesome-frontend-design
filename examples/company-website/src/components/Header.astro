---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site, hero } from '../data/site';
---

<header class="header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={`${site.name} - về đầu trang`}>
      <Logo />
      <span class="name">{site.name}</span>
    </a>

    <nav class="nav" aria-label="Điều hướng chính" data-nav>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a class="btn btn-primary cta" href={hero.primary.href}>
        {hero.primary.label}
        <Icon name="arrow" />
      </a>

      <details class="menu" data-menu>
        <summary aria-label="Mở menu">
          <Icon name="menu" class="open" />
          <Icon name="close" class="shut" />
        </summary>
        <div class="panel">
          <nav aria-label="Điều hướng trên điện thoại" data-nav>
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            </ul>
          </nav>
          <a class="btn btn-primary" href={hero.primary.href}>
            {hero.primary.label}
            <Icon name="arrow" />
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    text-decoration: none;
    min-width: 0;
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav {
    display: none;
  }
  .nav ul {
    display: flex;
    gap: var(--space-1);
  }
  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-3);
    font-size: 0.9375rem;
    font-weight: 450;
    color: var(--fg-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav a:hover,
  .nav a[aria-current] {
    color: var(--fg);
  }
  .nav a::after {
    content: '';
    position: absolute;
    inset: auto var(--space-3) 0.45rem;
    height: 1px;
    background: var(--accent-text);
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--dur-base) var(--ease-out);
  }
  .nav a[aria-current]::after,
  .nav a:hover::after {
    scale: 1 1;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .cta {
    display: none;
  }

  /* Menu di động: <details> nên dùng được khi không có JavaScript */
  .menu {
    position: relative;
  }
  .menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    list-style: none;
    cursor: pointer;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary > :global(svg) {
    grid-area: 1 / 1;
  }
  .menu :global(.shut),
  .menu[open] :global(.open) {
    display: none;
  }
  .menu[open] :global(.shut) {
    display: block;
  }
  .panel {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: 0;
    width: min(20rem, calc(100vw - var(--gutter) * 2));
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--bg-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }
  .panel a:not(.btn) {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .panel a[aria-current] {
    color: var(--accent-text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .panel {
      animation: drop var(--dur-fast) var(--ease-out) both;
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }

  @media (min-width: 64rem) {
    .nav {
      display: block;
    }
    .cta {
      display: inline-flex;
    }
    .menu {
      display: none;
    }
  }
</style>
