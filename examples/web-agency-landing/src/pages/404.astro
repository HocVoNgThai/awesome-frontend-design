---
import { url } from '../lib/url';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Không tìm thấy trang · Xưởng Web" noindex>
  <Header />
  <main id="main" class="section">
    <div class="wrap narrow-block">
      <p class="label">Lỗi 404</p>
      <h1 class="page-h1">Trang này không tồn tại.</h1>
      <p class="lead">Địa chỉ có thể đã đổi. Bạn có thể quay lại các mục chính:</p>
      <ul class="links">
        <li><a href={url('#dich-vu')}>Dịch vụ</a></li>
        <li><a href={url('#quy-trinh')}>Quy trình</a></li>
        <li><a href={url('#goi')}>Các gói</a></li>
        <li><a href={url('#lien-he')}>Nhận báo giá</a></li>
      </ul>
    </div>
  </main>
  <Footer />
</Base>
